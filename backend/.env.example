# DeskMind environment variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string (with pgvector extension enabled)
# SUPABASE_DATABASE_URL is the primary database used during development.
# DATABASE_URL is used as a fallback (e.g., for deployment).
SUPABASE_DATABASE_URL=postgresql://user:password@your-supabase-db-host:5432/postgres
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/deskmind

# JWT secret key (REQUIRED in production)
# In development, a default is used if omitted, but it is insecure.
JWT_SECRET_KEY=your_jwt_secret_here

# Groq API key (LLM)
GROQ_API_KEY=your_groq_api_key_here

# Voyage AI API key (embeddings)
VOYAGE_API_KEY=your_voyage_api_key_here

# Optional: override the Groq model (default: groq/compound-mini)
# GROQ_MODEL=groq/compound-mini

# Optional: environment mode (production enables strict config checks)
# ENV=production

# ---------------------------------------------------------------------------
# RAG (Retrieval-Augmented Generation) settings
# ---------------------------------------------------------------------------
# Enable hybrid vector + keyword search (default: true)
# RAG_ENABLE_HYBRID_SEARCH=true

# Number of candidates to retrieve from vector search before fusion (default: 15)
# RAG_VECTOR_TOP_K=15

# Number of candidates to retrieve from keyword search before fusion (default: 15)
# RAG_KEYWORD_TOP_K=15

# Maximum chunks to include in the final prompt after reranking (default: 5)
# RAG_FINAL_TOP_K=5

# Minimum reranker score required for a chunk to be included, 0.0-1.0 (default: 0.30)
# Below this threshold the bot returns "I don't know" rather than guessing.
# RAG_RELEVANCE_THRESHOLD=0.30

# Approximate token budget for context sent to the LLM (default: 4000)
# RAG_MAX_CONTEXT_TOKENS=4000

# Enable query rewriting for ambiguous follow-up questions (default: true)
# RAG_ENABLE_QUERY_REWRITE=true

# Number of recent conversation turns to inspect for reference resolution (default: 4)
# RAG_CONVERSATION_CONTEXT_TURNS=4
