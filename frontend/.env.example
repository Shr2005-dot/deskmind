# Base URL of the DeskMind backend API.
#
# Local development: the axios client defaults to http://localhost:8000, so
# this file is optional as long as the backend (uvicorn) runs on port 8000.
# Copy it to .env.local and change the value when the backend runs elsewhere.
#
# IMPORTANT (production): without this variable a deployed frontend keeps
# calling http://localhost:8000 inside every visitor's browser, so every
# sign-in fails with "Network Error". Set it to the deployed backend origin
# (https://...) BEFORE building, then redeploy. That origin must also be
# listed in RESTRICTED_ORIGINS in backend/app/main.py or requests will be
# blocked by CORS.
NEXT_PUBLIC_API_URL=http://localhost:8000
